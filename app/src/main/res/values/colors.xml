<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      LIGHT-MODE values. The values-night/colors.xml twin holds the dark ones.
      These four are the ONLY colours that need to exist in XML — everything else
      lives in AniobColor.kt. Keeping the XML set tiny is what stops the launch
      surface and the Compose surface from drifting apart.
    -->

    <!-- Must equal AniobLightScheme.background (Neutral98 = #FBFAFF).
         This is the single value that kills the cold-start white flash. -->
    <color name="aniob_window_background">#FBFAFF</color>

    <!-- Launcher icon backdrop. Was #1A1C1E (near-black) while the app was cyan/navy
         and the icon glyph was #00C853 green — three unrelated identities. -->
    <color name="ic_launcher_background">#4245B8</color>

    <!-- The mark itself. -->
    <color name="aniob_mark">#FFFFFF</color>

    <!-- Notification accent (small icon tint in the shade). -->
    <color name="aniob_notification_accent">#4245B8</color>

    <!-- true in light mode => dark icons on the transparent system bars. -->
    <bool name="aniob_light_system_bars">true</bool>
</resources>
